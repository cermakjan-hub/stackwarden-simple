[
  {
    "id": "vercel",
    "name": "Vercel",
    "kind": "hosting",
    "packages": {
      "npm": ["vercel", "@astrojs/vercel", "@sveltejs/adapter-vercel"]
    },
    "packagePrefixes": ["@vercel/"],
    "envPrefixes": ["VERCEL_"],
    "configFiles": ["vercel.json", ".vercel/project.json"],
    "linkedIds": [
      {
        "kind": "project",
        "file": ".vercel/project.json",
        "field": "projectId",
        "pattern": "^prj_[A-Za-z0-9]{8,64}$"
      },
      {
        "kind": "org",
        "file": ".vercel/project.json",
        "field": "orgId",
        "pattern": "^(?:team|org)_[A-Za-z0-9]{8,64}$"
      }
    ]
  },
  {
    "id": "railway",
    "name": "Railway",
    "kind": "hosting",
    "packages": {
      "npm": ["@railway/cli"]
    },
    "envPrefixes": ["RAILWAY_"],
    "configFiles": ["railway.json", "railway.toml"]
  },
  {
    "id": "github",
    "name": "GitHub",
    "kind": "source",
    "packages": {
      "npm": ["@octokit/rest", "@octokit/core", "octokit"],
      "pypi": ["PyGithub"]
    },
    "envPrefixes": ["GITHUB_APP_"]
  },
  {
    "id": "healthchecks",
    "name": "Healthchecks.io",
    "kind": "monitoring",
    "envPrefixes": ["HEALTHCHECKS_", "HC_PING_"],
    "hosts": ["hc-ping.com", "healthchecks.io"]
  },
  {
    "id": "supabase",
    "name": "Supabase",
    "kind": "database",
    "packages": {
      "npm": ["@supabase/supabase-js", "@supabase/ssr"],
      "pypi": ["supabase"]
    },
    "packagePrefixes": ["@supabase/"],
    "envPrefixes": ["SUPABASE_", "NEXT_PUBLIC_SUPABASE_", "VITE_SUPABASE_", "PUBLIC_SUPABASE_"],
    "configFiles": ["supabase/config.toml"],
    "linkedIds": [
      {
        "kind": "project",
        "file": "supabase/.temp/project-ref",
        "pattern": "^[a-z]{20}$"
      }
    ]
  },
  {
    "id": "neon",
    "name": "Neon",
    "kind": "database",
    "packages": {
      "npm": ["@neondatabase/serverless"]
    },
    "envPrefixes": ["NEON_"],
    "hosts": ["neon.tech"],
    "linkedIds": [
      {
        "kind": "project",
        "file": ".neon",
        "field": "projectId",
        "pattern": "^[a-z]+-[a-z]+-[a-z0-9]{6,8}$"
      }
    ]
  },
  {
    "id": "postgres",
    "name": "PostgreSQL",
    "kind": "database",
    "packages": {
      "npm": ["pg", "postgres"],
      "pypi": ["psycopg", "psycopg2", "psycopg2-binary", "asyncpg"]
    },
    "envNames": ["PGHOST", "PGPORT", "PGUSER", "PGPASSWORD", "PGDATABASE"],
    "envPrefixes": ["POSTGRES_"],
    "images": ["postgres", "postgis/postgis", "pgvector/pgvector"]
  },
  {
    "id": "mysql",
    "name": "MySQL",
    "kind": "database",
    "packages": {
      "npm": ["mysql2", "mysql"],
      "pypi": ["mysqlclient", "PyMySQL"]
    },
    "envPrefixes": ["MYSQL_"],
    "images": ["mysql", "mariadb"]
  },
  {
    "id": "mongodb",
    "name": "MongoDB",
    "kind": "database",
    "packages": {
      "npm": ["mongodb", "mongoose"],
      "pypi": ["pymongo", "motor"]
    },
    "envNames": ["MONGODB_URI", "MONGO_URL"],
    "envPrefixes": ["MONGODB_", "MONGO_"],
    "images": ["mongo"]
  },
  {
    "id": "redis",
    "name": "Redis",
    "kind": "cache",
    "packages": {
      "npm": ["redis", "ioredis"],
      "pypi": ["redis"]
    },
    "envNames": ["REDIS_URL"],
    "envPrefixes": ["REDIS_"],
    "images": ["redis", "valkey/valkey"]
  },
  {
    "id": "upstash",
    "name": "Upstash",
    "kind": "cache",
    "packagePrefixes": ["@upstash/"],
    "envPrefixes": ["UPSTASH_"]
  },
  {
    "id": "rabbitmq",
    "name": "RabbitMQ",
    "kind": "queue",
    "packages": {
      "npm": ["amqplib"],
      "pypi": ["pika"]
    },
    "envPrefixes": ["RABBITMQ_", "AMQP_"],
    "images": ["rabbitmq"]
  },
  {
    "id": "cloudflare",
    "name": "Cloudflare",
    "kind": "hosting",
    "packages": {
      "npm": [
        "wrangler",
        "@cloudflare/workers-types",
        "@astrojs/cloudflare",
        "@sveltejs/adapter-cloudflare",
        "@sveltejs/adapter-cloudflare-workers"
      ]
    },
    "packagePrefixes": ["@cloudflare/"],
    "envPrefixes": ["CLOUDFLARE_", "CF_"],
    "configFiles": ["wrangler.toml", "wrangler.jsonc", "wrangler.json"],
    "linkedIds": [
      {
        "kind": "project",
        "file": "wrangler.json",
        "field": "name",
        "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
      }
    ]
  },
  {
    "id": "netlify",
