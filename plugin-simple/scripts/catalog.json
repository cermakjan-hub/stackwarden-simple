    "configFiles": ["netlify.toml", ".netlify/state.json"],
    "linkedIds": [
      {
        "kind": "project",
        "file": ".netlify/state.json",
        "field": "siteId",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      }
    ]
  },
